{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run tests",
            "type": "process",
            "command": "${workspaceFolder}\\dev\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-v"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Format Python",
            "type": "process",
            "command": "${workspaceFolder}\\dev\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "black",
                "src",
                "tests",
                "main.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run application",
            "type": "process",
            "command": "${workspaceFolder}\\dev\\.venv\\Scripts\\python.exe",
            "args": [
                "main.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
